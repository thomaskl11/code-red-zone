# ESPN session (copy these from your browser cookies while logged into fantasy.espn.com --
# DevTools > Application > Cookies > https://fantasy.espn.com)
ESPN_S2=
ESPN_SWID=
ESPN_LEAGUE_ID=
ESPN_TEAM_ID=
ESPN_SEASON_YEAR=2026

# From console.anthropic.com
ANTHROPIC_API_KEY=

# Playwright storage state (see scripts/browser_actions.py header for how to generate this)
ESPN_STORAGE_STATE=

# Safety switch -- keep this "true" until you've watched a few weeks of dry runs
DRY_RUN=true
